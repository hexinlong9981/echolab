// Cloudflare への公開の設定（ADR-0011）。Worker（worker.js）で Basic 認証を行い、通過後に静的ファイルを配る。
// 密码存在 Cloudflare Worker secret WEB_PASSWORD 里。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echolab-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

