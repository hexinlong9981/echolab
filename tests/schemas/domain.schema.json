{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domain pack manifest",
  "description": "ドメインパックのマニフェスト（domains/*/domain.yaml）。コアとパックの契約（ADR-0003）",
  "type": "object",
  "required": [
    "name",
    "display_name",
    "version",
    "golden_dir",
    "prompts_dir",
    "filter_policy",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "パックの識別子。ディレクトリ名と一致させる",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "version": {
      "description": "パック自体の版（semver）",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "data_version": {
      "description": "パックが持つデータの版。データを持たないパックは data_dir とともに省略する",
      "type": "string",
      "minLength": 1
    },
    "data_dir": { "$ref": "#/$defs/relativePath" },
    "golden_dir": { "$ref": "#/$defs/relativePath" },
    "prompts_dir": { "$ref": "#/$defs/relativePath" },
    "filter_policy": {
      "description": "検索結果に適用するフィルタ方針。none=フィルタなし、progress=利用者が指定した進み具合（user_context の progress）でサービスが絞り込む",
      "enum": ["none", "progress"]
    },
    "user_context": {
      "description": "利用者が指定する項目（ツールの入力の名前）。LLM には見せず、ゲートウェイが利用者の値を入力に加える。filter_policy が progress なら progress を含める",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "answer_note": {
      "description": "検証に通った回答の末尾に Agent が必ず付ける注記（例：金融上の助言ではない旨）。検証の後に付けるため数字を含めない",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^0-9０-９]*$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "service", "implemented_in", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
          "service": { "type": "string", "minLength": 1 },
          "implemented_in": {
            "description": "実装したマイルストーン",
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "if": { "properties": { "filter_policy": { "const": "progress" } }, "required": ["filter_policy"] },
  "then": {
    "required": ["user_context"],
    "properties": { "user_context": { "contains": { "const": "progress" } } }
  },
  "dependentRequired": {
    "data_dir": ["data_version"],
    "data_version": ["data_dir"]
  },
  "$defs": {
    "relativePath": {
      "description": "パックのディレクトリからの相対パス",
      "type": "string",
      "pattern": "^[^/]",
      "minLength": 1
    }
  }
}
