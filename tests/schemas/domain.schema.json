{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domain pack manifest",
  "description": "ドメインパックのマニフェスト（domains/*/domain.yaml）。コアとパックの契約（ADR-0003）",
  "type": "object",
  "required": [
    "name",
    "display_name",
    "version",
    "data_version",
    "data_dir",
    "golden_dir",
    "prompts_dir",
    "filter_policy",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "パックの識別子。ディレクトリ名と一致させる",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "version": {
      "description": "パック自体の版（semver）",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "data_version": { "type": "string", "minLength": 1 },
    "data_dir": { "$ref": "#/$defs/relativePath" },
    "golden_dir": { "$ref": "#/$defs/relativePath" },
    "prompts_dir": { "$ref": "#/$defs/relativePath" },
    "filter_policy": {
      "description": "検索結果に適用するフィルタ方針。none=フィルタなし",
      "enum": ["none"]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "service", "implemented_in", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
          "service": { "type": "string", "minLength": 1 },
          "implemented_in": {
            "description": "実装したマイルストーン",
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "description": "パックのディレクトリからの相対パス",
      "type": "string",
      "pattern": "^[^/]",
      "minLength": 1
    }
  }
}
