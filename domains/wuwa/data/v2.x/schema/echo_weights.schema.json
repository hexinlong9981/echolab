{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "echo_weights",
  "type": "object",
  "required": ["schema_version", "max_roll", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "max_roll": {
      "$ref": "#/$defs/provenance",
      "type": "object",
      "required": ["verified", "source", "values"],
      "additionalProperties": false,
      "properties": {
        "verified": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "checked_at": { "$ref": "#/$defs/date" },
        "game_version": { "$ref": "#/$defs/gameVersion" },
        "values": { "$ref": "#/$defs/statMap" }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance",
        "type": "object",
        "required": ["id", "display_name", "verified", "source", "weights"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "display_name": { "type": "string" },
          "verified": { "type": "boolean" },
          "source": { "type": "string", "minLength": 1 },
          "checked_at": { "$ref": "#/$defs/date" },
          "game_version": { "$ref": "#/$defs/gameVersion" },
          "weights": { "$ref": "#/$defs/statMap" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "gameVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "provenance": {
      "description": "verified: true には出典の URL・確認日・ゲームの版が必須（ADR-0006）",
      "if": { "properties": { "verified": { "const": true } }, "required": ["verified"] },
      "then": {
        "required": ["checked_at", "game_version"],
        "properties": { "source": { "pattern": "^https://" } }
      }
    },
    "stat": {
      "enum": ["ATK_FLAT", "ATK_PERCENT", "HP_FLAT", "HP_PERCENT", "DEF_FLAT", "DEF_PERCENT", "CRIT_RATE", "CRIT_DMG", "ENERGY_REGEN", "BASIC_ATTACK_DMG_BONUS", "HEAVY_ATTACK_DMG_BONUS", "SKILL_DMG_BONUS", "LIBERATION_DMG_BONUS", "ELEMENTAL_DMG_BONUS", "HEALING_BONUS"]
    },
    "statMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/stat" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
