{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mushoku places",
  "description": "自作の地図。places がノード、routes が辺（days は移動の目安の日数）",
  "type": "object",
  "required": [
    "schema_version",
    "places",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "novel_vol",
          "anime_ep",
          "verified",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "region": {
            "type": "string"
          },
          "novel_vol": {
            "$ref": "#/$defs/vol"
          },
          "anime_ep": {
            "$ref": "#/$defs/anime"
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/provenance"
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "days",
          "novel_vol",
          "anime_ep",
          "verified",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "days": {
            "type": "integer",
            "minimum": 1
          },
          "novel_vol": {
            "$ref": "#/$defs/vol"
          },
          "anime_ep": {
            "$ref": "#/$defs/anime"
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/provenance"
          }
        ]
      }
    }
  },
  "$defs": {
    "anime": {
      "description": "アニメの話（\"期-話\"。例 \"2-12\"）。未アニメ化は null",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9]-[0-9]{1,2}$"
    },
    "vol": {
      "description": "小説（MF ブックス版）の巻。未収録は null",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 26
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "provenance": {
      "description": "verified: true には出典（巻・話などの具体的な箇所）と確認日が必須。未確認は TODO で始める（ADR-0006）",
      "if": {
        "properties": {
          "verified": {
            "const": true
          }
        },
        "required": [
          "verified"
        ]
      },
      "then": {
        "required": [
          "checked_at"
        ],
        "properties": {
          "source": {
            "pattern": "^(?!TODO)"
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "pattern": "^TODO"
          }
        }
      }
    }
  }
}
